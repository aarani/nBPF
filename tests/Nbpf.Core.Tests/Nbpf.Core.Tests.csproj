<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Nbpf.Core/Nbpf.Core.csproj" />
    <ProjectReference Include="../../src/Nbpf.Elf/Nbpf.Elf.csproj" />
    <ProjectReference Include="../../src/Nbpf.Btf/Nbpf.Btf.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Linked, not copied: eng/gen-fixtures.sh regenerates a single .o and the
         relocation tests here must see exactly what the ELF reader tests see. -->
    <None Include="../Nbpf.Elf.Tests/Fixtures/sample.bpf.o"
          Link="Fixtures/sample.bpf.o" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../Nbpf.Elf.Tests/Fixtures/core-sample.bpf.o"
          Link="Fixtures/core-sample.bpf.o" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../Nbpf.Elf.Tests/Fixtures/core-kernels.bpf.o"
          Link="Fixtures/core-kernels.bpf.o" CopyToOutputDirectory="PreserveNewest" />
    <!-- Minimized 5.4/6.8 vmlinux BTF (eng/gen-kernel-btf.sh), shared with Nbpf.Btf.Tests. -->
    <None Include="../Nbpf.Btf.Tests/Fixtures/vmlinux-*.min.btf"
          LinkBase="Fixtures" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
