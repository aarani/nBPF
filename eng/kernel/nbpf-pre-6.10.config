# Extra fragment for kernels older than 6.10, merged after nbpf.config by
# eng/build-kernel.sh (see its version table).
#
# Until 6.10's execmem rework, BPF_JIT and KPROBES both `depend on MODULES`. Kata's
# config builds a module-less kernel, so on these versions both options, and
# KPROBE_EVENTS with them, become invisible and olddefconfig drops them. Turning
# module support on brings them back. Everything the VM needs to boot (virtio, vsock,
# virtiofs, overlayfs) stays =y from the base config. Anything olddefconfig newly
# defaults to =m is built but never installed, which is harmless because nothing
# here depends on it.
CONFIG_MODULES=y
