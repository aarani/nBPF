# Fragment for eng/build-kernel.sh's qemu flavor (x86_64), merged after the kernel's
# own defconfig + KVM guest config. Everything eng/qemu-test.sh relies on to boot the
# runner's root filesystem and run the tests, built in, since there is no initramfs.
# Like the other fragments, every line must survive olddefconfig.

# The root filesystem and the writable checkout are 9p shares over virtio.
CONFIG_VIRTIO_PCI=y
CONFIG_NET_9P=y
CONFIG_NET_9P_VIRTIO=y
CONFIG_9P_FS=y
CONFIG_9P_FS_POSIX_ACL=y

# Test output goes to the serial console, which QEMU prints to the CI log.
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y

# The guest init mounts these itself.
CONFIG_DEVTMPFS=y
CONFIG_TMPFS=y

# Clean power-off from the init (echo o > /proc/sysrq-trigger).
CONFIG_MAGIC_SYSRQ=y

# DWARF, which DEBUG_INFO_BTF (from nbpf.config) is generated from; defconfig has
# none. On 5.4 this is a plain option; from 5.18 it is picked through the
# DEBUG_INFO_DWARF_* choice instead, so newer qemu kernels need a different line.
CONFIG_DEBUG_INFO=y
