# Config fragment eng/build-kernel.sh merges on top of either flavor's base config
# (eng/kernel/kata-*.config, or x86 defconfig + KVM guest config). It adds what the
# nBPF test suite needs. Every line here must survive `make olddefconfig` unchanged,
# or the build fails, so nothing silently drops out because of an unmet dependency.

CONFIG_LOCALVERSION="-nbpf"

# The bpf() syscall itself. Kata's config has it, but x86 defconfig doesn't, and
# BPF_EVENTS and XDP_SOCKETS below depend on it.
CONFIG_BPF_SYSCALL=y

# JIT instead of the interpreter, as on any production kernel.
CONFIG_BPF_JIT=y

# Tracepoint, kprobe and uprobe programs. BPF_EVENTS is what makes BPF_PROG_LOAD
# accept BPF_PROG_TYPE_TRACEPOINT/KPROBE at all; FTRACE_SYSCALLS provides the
# syscalls/sys_enter_* tracepoints the fixtures target.
CONFIG_FTRACE=y
CONFIG_FUNCTION_TRACER=y
CONFIG_DYNAMIC_FTRACE=y
CONFIG_FTRACE_SYSCALLS=y
CONFIG_TRACEPOINTS=y
CONFIG_KPROBES=y
CONFIG_KPROBE_EVENTS=y
CONFIG_UPROBE_EVENTS=y
CONFIG_BPF_EVENTS=y
CONFIG_KALLSYMS_ALL=y

# /sys/kernel/btf/vmlinux, for the KernelBtfFact tests and CO-RE against the running
# kernel. Needs pahole at configure time (PAHOLE_VERSION is probed then) and the
# DWARF debug info Kata's config already enables.
CONFIG_DEBUG_INFO_BTF=y

# AF_XDP sockets / XSKMAP.
CONFIG_XDP_SOCKETS=y

# tc (cls_bpf/act_bpf) programs, and the clsact qdisc they attach to.
CONFIG_NET_CLS_ACT=y
CONFIG_NET_CLS_BPF=y
CONFIG_NET_ACT_BPF=y
CONFIG_NET_SCH_INGRESS=y
